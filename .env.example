# .env.example

# Database
DATABASE_URL=postgresql://app_user:change_me@localhost:5432/nova_kaitori

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Public data source
SHEET_URL=

# Scraper Settings
SCRAPER_INTERVAL_MINUTES=30
SCRAPER_TIMEOUT_SECONDS=60

# Advertisement
AD_ENABLED=false
AD_PROVIDER=none
AD_CLIENT_ID=
AD_SLOT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_BASE_URL=https://api.openai.com/v1
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.5
KIMI_BASE_URL=https://api.moonshot.cn/v1
CODEX_PROXY_URL=http://host.docker.internal:8787/generate
CODEX_MODEL=gpt-5.4
FX_RATES_URL=https://open.er-api.com/v6/latest/JPY

# Member authentication
PUBLIC_APP_URL=http://localhost:5173
AUTH_ORIGINS=http://localhost:3000,http://localhost:5173
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Password reset email (disabled until SMTP is configured)
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
